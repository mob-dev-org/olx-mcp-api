# =====================================================================
# JEDAN KLON = JEDAN KLIJENT = JEDAN NALOG
# =====================================================================
# Ovaj repozitorij se klonira po klijentu. U .env ovog klona ide token
# SAMO tog jednog naloga. Za drugog klijenta kloniraj repo ponovo.
# Pravi .env je u .gitignore i nikad ne ide u git.
#
# Ko je klijent ovog klona opisuje KLIJENT.md (kopiraj KLIJENT.primjer.md).

# Bazni URL API-ja. Uz rebrand olx.ba -> pik.ba moguce je da se promijeni u https://api.pik.ba
OLX_BASE_URL=https://api.olx.ba

# Preporuceni nacin: vec dobijen Bearer token naloga. Ako je postavljen, login se preskace.
OLX_TOKEN=

# Alternativa: login kredencijalima (token se dobije pozivom auth login). Kad su postavljeni,
# toolkit moze sam obnoviti token kad istekne (401). Lozinku drzi u keychainu, ne ovdje.
OLX_USERNAME=
OLX_PASSWORD=
OLX_DEVICE_NAME=olx_pik_toolkit

# Alternativa: stari tokeni (ako nemas pristup lozinki)
OLX_CLIENT_ID=
OLX_CLIENT_TOKEN=

# Konzervativni throttling (ms izmedju zahtjeva) i broj pokusaja
OLX_MIN_REQUEST_INTERVAL_MS=350
OLX_MAX_RETRIES=4
OLX_TIMEOUT_MS=20000

# Oglasi koje vlasnik ne zeli automatski obnavljati ni izdvajati (JSONL/JSON, van gita).
# Pise se kroz alat olx_izuzeca, a cita ga i dnevna cron obnova.
OLX_IZUZECA_FILE=.olx-pik/izuzeca.json

# Audit log: zapis svake radnje koja mijenja stanje ili trosi kredite (JSONL, van gita).
OLX_AUDIT_FILE=.olx-pik/audit.jsonl
# Postavi na 1 ako hoces da se u log pisu i citanja (GET). Default je samo upisi.
OLX_AUDIT_READS=0

# =====================================================================
# KLIJENTSKI RUNTIME
# =====================================================================

# Koliko alata MCP server izlaze.
#   admin   = svih 39, ukljucujuci sirove dumpove kategorija i lokacija (rad na repou)
#   klijent = 28, bez alata za katalog i lokacije (bot kojim se sluzi musterija)
# Nepoznata vrijednost pada na admin, da se alati ne sakriju greskom u kucanju.
OLX_MCP_PROFILE=admin

# Tvrdi dnevni plafon potrosnje u kreditima. 0 znaci bez plafona.
# Kad se dostigne, radnja se odbija i javlja administratoru, ne klijentu.
OLX_MAX_SPEND_PER_DAY=0

# Podrazumijevana lokacija za objavu, da model ne mora pretrazivati gradove.
# BiH je country_id 49. Grad procitaj jednom kroz: node dist/cli/index.js location cities
OLX_DEFAULT_COUNTRY_ID=49
OLX_DEFAULT_CITY_ID=

# =====================================================================
# AI POGON KLIJENTSKE SESIJE
# =====================================================================
# Na cemu radi klijentski bot. Cita ga scripts/cuvar-sesije.mjs (i pokreni-klijenta.sh).
#   pretplata = vlasnikova Claude pretplata (default; faza testiranja prvih klijenata)
#   deepseek  = DeepSeek API preko donjih varijabli; bez popunjenih varijabli sesija se NE
#               pokrece, da klijent ne bi tiho presao na pretplatu
# Admin bot sesija (cuvar-sesije.mjs admin-bot) uvijek ide na pretplatu i ovo je ne dira.
OLX_KLIJENT_AI=pretplata

# Vrijednosti i objasnjenja: olx-dokumentacija/deepseek-nalazi.md. Prefiks OLX_ je namjeran:
# gole ANTHROPIC_* varijable u .env bi kroz loadEnvFile preuzele i CLI i druge procese.
OLX_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
OLX_DEEPSEEK_AUTH_TOKEN=
OLX_DEEPSEEK_MODEL=deepseek-v4-pro
OLX_DEEPSEEK_HAIKU_MODEL=deepseek-v4-flash
OLX_DEEPSEEK_TIMEOUT_MS=600000

# =====================================================================
# VID (vision proxy za pogon bez vida, npr. DeepSeek)
# =====================================================================
# DeepSeek endpoint ignorise slike, pa objava artikla iz fotografije tamo ne radi direktno.
# Sa postavljenim kljucem MCP server registruje alat olx_opisi_sliku: slika ide jeftinom
# vision modelu (Claude Haiku, red velicine desetinke centa po slici), a sesija dobije
# tekstualni opis i nastavi. Bez kljuca se alat uopste ne registruje i ne kosta kontekst;
# na pretplati nije potreban jer sesija vidi slike sama.
#
# Provajder: anthropic (default) ili gemini. Gemini je oko cetiri puta jeftiniji po slici i
# koristi ISTI kljuc kao generisanje slika ispod, pa je cijeli put slike na jednom mjestu i
# fotografije klijenta idu samo jednom vanjskom servisu. Kad je provajder gemini, kljuc se
# moze izostaviti i tada se uzima OLX_SLIKA_API_KEY.
# Model se ostavlja prazan osim kad se svjesno mijenja: default je claude-haiku-4-5 za
# anthropic, gemini-3.1-flash-lite za gemini. OLX_VID_BASE_URL vazi samo za anthropic.
OLX_VID_PROVAJDER=anthropic
OLX_VID_API_KEY=
OLX_VID_MODEL=
OLX_VID_BASE_URL=

# =====================================================================
# SLIKA (generisanje slike oglasa iz klijentove fotografije)
# =====================================================================
# Kljuc iz Google AI Studija; isti kljuc pokriva i opis slike gore (OLX_VID_PROVAJDER=gemini).
# Sa njim MCP server registruje alat olx_generiraj_sliku: iz
# fotografije koju je klijent poslao napravi istu stvar u cistom prostoru i sa ravnim
# svjetlom. Artikal se NE popravlja, samo prostor i svjetlo. Bez kljuca se alat ne registruje.
# Ovo trosi vanjski AI racun, ne OLX kredite, pa alat trazi potvrdu i ima dnevni plafon.
# Izmjereno 30.07.2026: oko $0.041 po generisanoj slici (izlazna slika se naplacuje $30 po
# milionu tokena, odvojeno od izlaznog teksta). Klijentove ulazne fotografije su prakticno
# besplatne, 1120 tokena po slici. Zato je plafon 10: to je oko $12 mjesecno u najgorem slucaju.
# Zadani odnos strana je 4:3 jer je kartica oglasa u aplikaciji pejzazna.
OLX_SLIKA_API_KEY=
OLX_SLIKA_MODEL=gemini-3.1-flash-lite-image
OLX_SLIKA_BASE_URL=
OLX_SLIKA_MAX_DNEVNO=10
OLX_SLIKA_DIR=

# =====================================================================
# TELEGRAM (cron izvjestaji i klijentski bot)
# =====================================================================

# Bot token iz BotFathera, jedan po klijentu.
TELEGRAM_BOT_TOKEN=
# Grupa u kojoj bot razgovara sa klijentom (negativan broj).
TELEGRAM_CHAT_ID=
# Tvoj DM. Ovdje idu greske iz cron poslova, ne klijentu.
TELEGRAM_ADMIN_CHAT_ID=
