# =====================================================================
# JEDAN KLON = JEDAN KLIJENT = JEDAN NALOG
# =====================================================================
# Ovaj repozitorij se klonira po klijentu. U .env ovog klona ide token
# SAMO tog jednog naloga. Za drugog klijenta kloniraj repo ponovo.
# Pravi .env je u .gitignore i nikad ne ide u git.
#
# Ko je klijent ovog klona opisuje KLIJENT.md (kopiraj KLIJENT.primjer.md).

# Bazni URL API-ja. Uz rebrand olx.ba -> pik.ba moguce je da se promijeni u https://api.pik.ba
OLX_BASE_URL=https://api.olx.ba

# Preporuceni nacin: vec dobijen Bearer token naloga. Ako je postavljen, login se preskace.
OLX_TOKEN=

# Alternativa: login kredencijalima (token se dobije pozivom auth login). Kad su postavljeni,
# toolkit moze sam obnoviti token kad istekne (401). Lozinku drzi u keychainu, ne ovdje.
OLX_USERNAME=
OLX_PASSWORD=
OLX_DEVICE_NAME=olx_pik_toolkit

# Alternativa: stari tokeni (ako nemas pristup lozinki)
OLX_CLIENT_ID=
OLX_CLIENT_TOKEN=

# Konzervativni throttling (ms izmedju zahtjeva) i broj pokusaja
OLX_MIN_REQUEST_INTERVAL_MS=350
OLX_MAX_RETRIES=4
OLX_TIMEOUT_MS=20000

# Rok (ms) za mrezni poziv provjere zaostajanja klona za izdanjem (SessionStart hook,
# provjeri-izdanje.mjs). Provjera je tiha i ne smije zavjesiti pokretanje sesije. Prazno znaci
# NULA (Number("") je 0), a nula rok pretvara u trenutni timeout, pa provjera prakticno nikad ne
# stigne. Zato je ovdje upisana izricita vrijednost.
OLX_PROVJERA_IZDANJA_ROK_MS=5000

# =====================================================================
# CITANJE KATALOGA: OSIGURAC I BUDZETI (listAllByState / listAllActive)
# =====================================================================
# Prelistavanje kataloga (obnove, grupne izmjene, pretraga po opisu) vise NE staje tiho na
# fiksan broj stranica. Dva NEZAVISNA ogranicenja rade zajedno, jer broj stranica ne zna za
# retry, throttle ni spor API, a vrijeme ne zna za pokvaren odgovor servera.

# Osigurac, NE podesavanje brzine. Jedini mu je zadatak da pokvaren last_page sa API-ja ne
# uvrti prelistavanje u beskonacnu petlju. Namjerno je iznad svakog realnog kataloga (5000
# stranica = 100 000 oglasa), da u normalnom radu nikad ne stigne do njega.
OLX_MAX_STRANICA_LISTE=5000

# Budzet vremena (ms) za alate koje covjek zove u razgovoru i ceka odgovor (npr. olx_find_my_listing,
# olx_sablon_opisa). Kad budzet istekne prije last_page, lista se vraca kao NEPOTPUNA sa razlogom,
# umjesto da tiho stane. Racunica: 1 stranica je 20 oglasa i oko 0,57 s (350 ms throttle plus oko
# 220 ms mreze), pa 75 s budzeta znaci oko 131 stranicu odnosno oko 2620 oglasa. Krov prekoracaja
# je jedna stranica u letu (20 s timeout puta 5 pokusaja plus backoff), oko 107 s, sto ostaje
# ispod MCP zida od 300 s.
OLX_BUDZET_LISTE_MS=75000

# Budzet vremena (ms) za grupne radnje uz izricitu potvrdu (olx_bulk_price, olx_bulk_sklanjanje,
# olx_refresh_bulk): duzi je jer grupni alat cita cijeli katalog prije nego uopste pita za potvrdu.
# Gornja granica dolazi odavde, ne od nagadjanja: izmjereno citanjem stringova iz binara Claude
# Code verzije 2.1.232, dana 14.08.2026, podrazumijevani timeout jednog MCP tool poziva je 60000 ms,
# i to je ujedno DONJI prag jer se manje zadane vrijednosti dizu na 60000. Polje "timeout" po
# serveru u .mcp.json ga nadjacava. Progress notifikacije rok NE produzavaju, to je tvrdi wall-clock
# limit po pozivu. Zato .mcp.json postavlja 300000 ms za server olx-pik, a budzeti iznad su
# postavljeni tako da alat UVIJEK vrati odgovor sam, prije tog zida.
OLX_BUDZET_LISTE_GRUPNI_MS=120000

# Budzet vremena (ms) za obilazak TUDJEG shopa (konkurenta, olx_competitor_report) u serijskom
# prolazu kroz cijeli Excel spisak kandidata. Namjerno kratak: konkurenti se obilaze redom, jedan
# za drugim, pa dug budzet ovdje znaci da red kandidata ceka. Vlastiti kljuc, odvojen od
# OLX_BUDZET_LISTE_MS, zato da dizanje razgovornog budzeta ne uspori citav obilazak. Postojeci
# klon bez izmjene ove vrijednosti u .env dobija tacno staro ponasanje.
OLX_BUDZET_LISTE_KONKURENT_MS=20000

# Najveci broj oglasa koji olx_list_listings sa all:true smije staviti u JEDAN odgovor. Iznad
# toga se katalog isporucuje u komadima (parametar komad), umjesto da se tiho sijece ili da se
# odgovor odbije. Racunica je u TOKENIMA, ne u broju oglasa: mjereno u olx-dokumentacija/deepseek-nalazi.md
# (tabela oko linije 110), 120 oglasa u kompaktnom obliku je 6.135 tokena; CSV je oko 60% jeftiniji,
# dakle oko 20 tokena po oglasu. Na pragu od 500 oglasa to je oko 10.000 tokena, cetvrtina do
# trecina cijelog prefiksa jedne sesije, za JEDAN odgovor JEDNOG alata.
OLX_MAX_OGLASA_U_ODGOVORU=500

# Prag reza za spiskove u odgovoru grupnih alata (olx_bulk_price, olx_bulk_sklanjanje,
# olx_refresh_bulk): koliko kandidata/gresaka/neaktivnih stavki smije stati u JEDAN odgovor.
# Odvojen od OLX_MAX_OGLASA_U_ODGOVORU jer su stavke ovdje laksi objekti ({id, title} ili
# {id, greska}), ne pun oglas. Nije parametar poziva (za razliku od operativnih "limit" polja
# koja biraju koliko oglasa se STVARNO mijenja): ovo je samo tehnicki osigurac protiv velikog
# JSON odgovora. Rez je uvijek vidljiv: uz odsjecenu listu ide broj koliko je stvarno bilo.
OLX_MAX_STAVKI_U_ODGOVORU=200

# Oglasi koje vlasnik ne zeli automatski obnavljati ni izdvajati (JSONL/JSON, van gita).
# Pise se kroz alat olx_izuzeca, a cita ga i dnevna cron obnova.
OLX_IZUZECA_FILE=.olx-pik/izuzeca.json

# Arhiva skinutih artikala (olx_skini_artikal): opis oglasa + originalne slike, van gita.
# Raste samo eksplicitnom odlukom klijenta; prazno = default putanja.
OLX_ARHIVA_DIR=.olx-pik/arhiva-artikala

# Audit log: zapis svake radnje koja mijenja stanje ili trosi kredite (JSONL, van gita).
OLX_AUDIT_FILE=.olx-pik/audit.jsonl
# Postavi na 1 ako hoces da se u log pisu i citanja (GET). Default je samo upisi.
OLX_AUDIT_READS=0

# Dnevnik potrosnje AI pogona (JSONL, van gita). Prazno pada na .olx-pik/ai-usage.jsonl.
OLX_AI_USAGE_FILE=.olx-pik/ai-usage.jsonl

# Pamcenje bota o klijentu izmedju sesija (JSON, van gita). Prazno pada na .olx-pik/pamcenje.json.
OLX_PAMCENJE_FILE=.olx-pik/pamcenje.json

# Mapa prijedloga (npr. SEO prijedlozi za pregled) koje bot ostavlja covjeku. Prazno pada na
# .olx-pik/prijedlozi.
OLX_PRIJEDLOZI_DIR=.olx-pik/prijedlozi

# =====================================================================
# KLIJENTSKI RUNTIME
# =====================================================================

# Koliko alata MCP server izlaze.
#   admin   = svih 39, ukljucujuci sirove dumpove kategorija i lokacija (rad na repou)
#   klijent = 28, bez alata za katalog i lokacije (bot kojim se sluzi musterija)
# Nepoznata vrijednost pada na admin, da se alati ne sakriju greskom u kucanju.
OLX_MCP_PROFILE=admin

# Tvrdi dnevni plafon potrosnje u kreditima. 0 znaci bez plafona.
# Kad se dostigne, radnja se odbija i javlja administratoru, ne klijentu.
OLX_MAX_SPEND_PER_DAY=0

# Podrazumijevana lokacija za objavu, da model ne mora pretrazivati gradove.
# BiH je country_id 49. Grad procitaj jednom kroz: node dist/cli/index.js location cities
OLX_DEFAULT_COUNTRY_ID=49
OLX_DEFAULT_CITY_ID=

# Dan u mjesecu kad se obnavlja kvota besplatnih obnova, 1 do 31. OSTAVI PRAZNO na nalogu sa
# shopom: dan se tada cita iz shop.ends_at, a upisana vrijednost bi bila drugi izvor istine koji
# moze odlutati od API-ja. Popuni SAMO za nalog bez shopa, gdje ends_at ne postoji. Vrijednost van
# opsega se odbacuje, pa pogresan upis ne postane rok koji se tvrdi klijentu.
OLX_DAN_CIKLUSA_KVOTE=

# =====================================================================
# AI POGON KLIJENTSKE SESIJE
# =====================================================================
# Na cemu radi klijentski bot. Cita ga scripts/cuvar-sesije.mjs (i pokreni-klijenta.mjs).
#   deepseek  = DeepSeek API preko donjih varijabli (default za nove klonove, odluka
#               03.08.2026); bez popunjenih varijabli sesija se NE pokrece, pa klon ne moze
#               tiho preci na pretplatu
#   pretplata = vlasnikova Claude pretplata
# Kad varijabla u .env uopste ne postoji, kod pada na pretplatu (istorijsko ponasanje).
# Admin bot sesija (cuvar-sesije.mjs admin-bot) uvijek ide na pretplatu i ovo je ne dira.
OLX_KLIJENT_AI=deepseek

# Vrijednosti i objasnjenja: olx-dokumentacija/deepseek-nalazi.md. Prefiks OLX_ je namjeran:
# gole ANTHROPIC_* varijable u .env bi kroz loadEnvFile preuzele i CLI i druge procese.
# Model: default je flash, uvijek (odluka vlasnika 04.08.2026, cijena). deepseek-v4-pro je
# izbor po klijentu: jedini je u mjerenju sam trazio cijenu izdvajanja prije troska
# (deepseek-nalazi.md); brana confirm u kodu stoji nezavisno od modela.
OLX_DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
OLX_DEEPSEEK_AUTH_TOKEN=
OLX_DEEPSEEK_MODEL=deepseek-v4-flash
OLX_DEEPSEEK_HAIKU_MODEL=deepseek-v4-flash
OLX_DEEPSEEK_TIMEOUT_MS=600000

# Fajl sa DeepSeek kredencijalima za rucnu probu (scripts/deepseek-proba.mjs), odvojen od .env
# jer proba nije dio klijentskog runtime-a. Prazno pada na ~/.claude/deepseek.env.
DEEPSEEK_ENV_FILE=

# =====================================================================
# CUVAR SESIJE
# =====================================================================
# Ponasanje cuvara (scripts/cuvar-sesije.mjs) na prag mirovanja i na nocni termin.

# Strazar rezim: umjesto RESTARTA sesije na idle prag i na nocni termin, cuvar sesiju UGASI i
# sam preuzme Telegram strazu dok sesija spava (getUpdates, offset se NE potvrdjuje, pa prvu
# poruku poslije mirovanja pojede plugin kad sesija ustane, ne cuvar). Dobitak: klon u mirovanju
# pada sa ~200 do 500 MB na ~10 do 20 MB. Cijena: prva poruka poslije mirovanja ceka hladni start
# sesije (claude + MCP + plugin), procjena 5 do 15 s. Start cuvara (boot masine) i dalje digne
# sesiju odmah, bez obzira na ovaj prekidac, da se pokvaren setup otkrije na startu a ne na prvu
# klijentovu poruku.
# Prazno = ISKLJUCENO (default). Bez ovog prekidaca ponasanje ostaje bajt za bajt danasnje: nocni
# i idle prag samo ciste kontekst, sesija ostaje dignuta.
# Prihvacene vrijednosti (neosjetljivo na velika/mala slova i razmake):
#   1 / true / da = ukljuceno za OBA tipa sesije (klijentska i admin bot)
#   admin         = ukljuceno SAMO za admin bot sesiju
#   klijent       = ukljuceno SAMO za klijentsku sesiju
# Neprepoznata vrijednost pada na iskljuceno, uz upozorenje u log.
# Uvodjenje je opt in PO KLONU. Preporuceni redoslijed: prvo admin bot (OLX_SESIJA_STRAZAR=admin),
# tek kad se pokaze stabilno i klijentska sesija.
OLX_SESIJA_STRAZAR=

# Sat nocnog ciklusa (0 do 23), default 3. Tada se kontekst razgovora vraca na nulu (ili se
# sesija UGASI kad je strazar ukljucen), cisti se stari Telegram inbox i skracuju cron logovi.
OLX_SESIJA_RESTART_SAT=

# Sati mirovanja bez poruke prije ciscenja konteksta, default zavisi od strazar rezima. Bez
# strazara (OLX_SESIJA_STRAZAR iskljucen): klijent 2, admin bot 1, jer istek praga tu sesiju
# samo RESTARTUJE (kontekst se brise, proces ostaje dignut, memorija se ne oslobadja), pa kratak
# prag ne stedi nista i samo kosta kontinuitet razgovora. Sa strazarom istek praga sesiju GASI i
# memorija se stvarno oslobodi, pa je prag kraci: klijent 1, admin bot 0.5 (30 min). Prima i
# decimale. Nula iskljucuje prag mirovanja.
OLX_SESIJA_IDLE_SATI=

# Starost (u danima) fajlova iz Telegram inboxa koji se brisu u nocnom ciklusu, default 7.
OLX_SESIJA_INBOX_DANA=

# Telemetrija resursa: cuvar (isti proces koji vec strazari, bez novog zakazanog posla)
# periodicno upisuje red u .olx-pik/resursi/ (RSS cuvara i cijelog stabla sesije - sesija + MCP
# + bun poller, slobodnu memoriju i swap masine, dogadjaje starta/pada/budjenja iz straze sa
# trajanjem hladnog starta). Sluzi vlasniku flote da vidi trosak resursa po klijentu:
# node scripts/resursi.mjs pregled / izvjestaj / dijagnostika. Nikad ne ide u backup stanja
# (crni spisak).
# Dva razlicita intervala jer aktivna sesija treba gusce uzorkovanje od mirne straze (gdje je
# RSS cuvara ravan i cesce uzorkovanje ne bi nista pokazalo):
OLX_RESURSI_INTERVAL_MIN=5
# Minuta dok sesija zivi, default 5. PRAZNA vrijednost znaci NULA (Number("") je 0), dakle
# telemetrija ISKLJUCENA U CJELINI (i strazarsko uzorkovanje); potpuno ODSUTNA varijabla pada
# na default 5. Ovdje je vrijednost upisana izricito (5) da nov klon iz ovog fajla dobije
# telemetriju ukljucenu, ne iskljucenu.

OLX_RESURSI_INTERVAL_STRAZA_MIN=30
# Minuta dok cuvar strazari (sesija ugasena), default 30. PRAZNA vrijednost znaci NULA, dakle
# iskljucuje SAMO uzorkovanje tokom straze (aktivna sesija se i dalje uzorkuje po gornjem
# intervalu); potpuno ODSUTNA varijabla pada na default 30. Ovdje je vrijednost upisana izricito
# (30) da nov klon dobije strazarsko uzorkovanje ukljuceno.

# Gdje se pisu redovi telemetrije, jedan fajl po mjesecu (resursi-YYYY-MM.jsonl), cuvaju se 12
# mjeseci pa se stariji brisu u nocnom ciklusu. Prazno pada na .olx-pik/resursi.
OLX_RESURSI_DIR=

# Alarm van reda kad je masina pod pritiskom (malo slobodne memorije ili visok swap): cuvar ovo
# provjerava na svakom uzorku telemetrije (gornji interval), pa salje adminu ODMAH, ne ceka
# sedmicni izvjestaj flote. Deset klonova na istoj masini dijele oznaku van klona
# (~/.olx-pik-masina-alarm.json) da ne posalju deset skoro istih poruka; ako ta oznaka nije
# dostupna (dozvole, drugi korisnik), svaki klon tiho pada na svoju oznaku u .olx-pik/.
OLX_RESURSI_PRAG_SLOBODNO_MB=
# Slobodna memorija masine ispod koje se salje alarm, u MB. Prazno pada na default 2048 (2 GB).

OLX_RESURSI_PRAG_SWAP_OMJER=
# Udio iskoristenog swapa (0 do 1) iznad kojeg se salje alarm. Prazno pada na default 0.85.

OLX_RESURSI_PRAG_ALARM_SATI=
# Najmanje sati izmedju dva alarma pritiska (za isti izvor, dijeljeni ili po klonu). Prazno pada
# na default 6.

# Putanja dijeljene oznake alarma pritiska NA NIVOU MASINE (van svih klonova), da deset klonova
# na istoj masini ne posalju deset skoro istih poruka. Prazno pada na
# ~/.olx-pik-masina-alarm.json.
OLX_MASINA_ALARM_FAJL=

# Gdje dnevni nadzor flote (scripts/nadzor-flote.mjs, ADMIN posao) upisuje kolekciju. Trostruki
# redoslijed: 1) ova varijabla (trim) ako je neprazna, 2) kad je spisak klonova nadjen kroz root
# sken, podfolder "nadzor" u tom rootu, 3) inace ~/olx-nadzor. Prazno je ispravno na obicnom
# klonu, ovo se popunjava samo na masini koja nadzire flotu.
OLX_NADZOR_DIR=

# Bazni URL Gemini API-ja, dijeli ga vid (olx_opisi_sliku) i generisanje slike
# (olx_generiraj_sliku). Prazno pada na https://generativelanguage.googleapis.com/v1beta.
OLX_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# =====================================================================
# VID (vision proxy za pogon bez vida, npr. DeepSeek)
# =====================================================================
# DeepSeek endpoint ignorise slike, pa objava artikla iz fotografije tamo ne radi direktno.
# Vid je ISKLJUCIVO Gemini (odluka vlasnika 04.08.2026) i po pravilu ne trazi nista svoje:
# koristi OLX_SLIKA_API_KEY ispod, pa jedan Gemini kljuc pokriva cijeli put slike (opis +
# generisanje) i fotografije klijenta idu samo jednom vanjskom servisu. Sa kljucem MCP server
# registruje alat olx_opisi_sliku (gemini-3.1-flash-lite, najjeftiniji, oko desetinke centa po
# slici); bez kljuca se alat ne registruje i ne kosta kontekst. Na pretplati nije potreban.
# Dvije varijable ispod su opcioni izuzeci: poseban Gemini kljuc samo za vid i drugi model.
OLX_VID_API_KEY=
OLX_VID_MODEL=

# =====================================================================
# TELEFON KANDIDATA (CLI stats konkurent-telefon, prospecting drugih shopova)
# =====================================================================
# OLX API ne vraca broj telefona ni za jedan tudji nalog, pa se izvlaci iz slobodnog teksta
# opisa shopa i oglasa: prvo besplatan regex prolaz, pa Haiku poziv tek kad regex ne nadje
# nista sigurno. Bez kljuca komanda i dalje radi, samo bez Haiku prolaza (samo regex). Ovo je
# jedino mjesto koje trazi Anthropic kljuc; vid gore je Gemini i njegov kljuc ovdje ne vrijedi.
OLX_TELEFON_API_KEY=
OLX_TELEFON_MODEL=

# =====================================================================
# SLIKA (generisanje slike oglasa iz klijentove fotografije)
# =====================================================================
# Kljuc iz Google AI Studija; isti kljuc pokriva i opis slike gore (vision proxy).
# Sa njim MCP server registruje alat olx_generiraj_sliku: iz
# fotografije koju je klijent poslao napravi istu stvar u cistom prostoru i sa ravnim
# svjetlom. Artikal se NE popravlja, samo prostor i svjetlo. Bez kljuca se alat ne registruje.
# Ovo trosi vanjski AI racun, ne OLX kredite, pa alat trazi potvrdu i ima dnevni plafon.
# Izmjereno 30.07.2026: oko $0.041 po generisanoj slici (izlazna slika se naplacuje $30 po
# milionu tokena, odvojeno od izlaznog teksta). Klijentove ulazne fotografije su prakticno
# besplatne, 1120 tokena po slici. Zato je plafon 10: to je oko $12 mjesecno u najgorem slucaju.
# Odnos strana se uzima od ULAZNE slike; 4:3 je samo rezerva kad se dimenzije ne mogu procitati.
OLX_SLIKA_API_KEY=
OLX_SLIKA_MODEL=gemini-3.1-flash-lite-image
OLX_SLIKA_BASE_URL=
OLX_SLIKA_MAX_DNEVNO=10
OLX_SLIKA_DIR=

# Jednodnevni override plafona generisanja slika (olx_limit_slika, samo admin). Vazi SAMO za dan
# kad je upisan, sutra automatski pada nazad na OLX_SLIKA_MAX_DNEVNO/fallback.
OLX_SLIKA_LIMIT_FILE=

# Poslije uspjesnog uploada na OLX slika je odradila posao i brise se, ali tek kad prodje ova
# odgoda. Odgoda postoji jer upload zna proci djelimicno i jer klijent zna minut kasnije traziti
# drugu glavnu sliku ili ponovni pokusaj; brisanje u istom potezu bi tada ostavilo posao bez
# izvora. Brise se SAMO ono sto je pogon sam napravio (OLX_SLIKA_DIR i Telegram inbox), nikad
# fajl koji je adminu negdje drugdje na masini. Popis onoga sto ceka brisanje je prolazan i ne
# ide u backup. Postavi 0 za brisanje pri prvom sljedecem poslu sa slikama.
OLX_SLIKE_ODGODA_MIN=60
OLX_SLIKE_POTROSENE_FILE=

# Stalna pozadina klijenta: scena na koju recept pozadina-klijenta stavlja artikle, umjesto na
# bijelu podlogu. Zada se jednom kroz alat olx_pozadina, kao opis rijecima, kao slika, ili oboje.
# Slika se KOPIRA ovdje, pa original iz Telegram inboxa smije nestati. Ovo je jedini binarni fajl
# koji ide u backup stanja, jer bez njega poslije oporavka novi oglasi dobiju drugu pozadinu od
# starih. Pozadina se svaki put crta iznova, dakle SLICNA je a nikad identicna; tekst i logo na
# njoj ce biti iskrivljeni, za doslovno istu brendiranu pozadinu ovaj alat nije dovoljan.
OLX_POZADINA_DIR=

# Trag zahtjeva prema generatoru slika: sta je trazeno i sta je odbijeno, doslovno.
# Odvojen od ai-usage.jsonl namjerno: taj dnevnik nosi samo brojeve i nikad sadrzaj, a ovdje
# nam treba tekst koji je covjek napisao, jer se bez njega zloupotreba ne moze istraziti.
# U klijentskom profilu (OLX_MCP_PROFILE=klijent) generator prima samo recept sa spiska, uz
# obaveznu ulaznu fotografiju i kratku dopunu koja prolazi kroz filter. Admin ostaje slobodan.
OLX_SLIKE_TRAG_FILE=

# Ritam obnavljanja koji je trazio klijent (ravnomjerno, sve-dostupno, interval). Upisuje ga alat
# olx_ritam_obnova, cita ga dnevni posao. Bez fajla ide ravnomjerno.
OLX_RITAM_FILE=
# Dnevno stanje besplatne kvote obnova, jedan red po danu. Sluzi da se vidi KAD se kvota
# obnavlja: API taj datum ne vraca, pa je serija jedini nacin da se dan reseta prepozna.
OLX_KVOTA_DNEVNIK_FILE=

# =====================================================================
# TELEGRAM (cron izvjestaji i klijentski bot)
# =====================================================================

# Bot token iz BotFathera, jedan po klijentu.
TELEGRAM_BOT_TOKEN=
# DOPUNA spiska grupa, ne glavni izvor. Smije ostati prazan.
#
# Izvjestaji idu u svaku grupu pod "groups" u .claude-runtime/channels/telegram/access.json, jer
# je to isti spisak po kojem bot prima poruke, pa se ne vodi dvaput. Grupa se dodaje sa:
#   node dist/cli/index.js telegram grupe dodaj <id_grupe>
# a spisak odredista se vidi sa: node dist/cli/index.js telegram grupe
#
# Ovdje se upisuje samo odrediste koje NIJE grupa sa tim spiskom. Vise njih ide zarezom
# (TELEGRAM_CHAT_ID=-100123,-100456); id koji je ovdje a nije u access.json prima izvjestaj, ali
# bot u toj grupi ne odgovara na poruke, pa to provjeri-klon.mjs prijavljuje kao PAZNJA.
TELEGRAM_CHAT_ID=
# Tvoj DM. Ovdje idu greske iz cron poslova, ne klijentu.
TELEGRAM_ADMIN_CHAT_ID=

# Gdje stoji access.json sa spiskom grupa. Prazno je ispravno: trazi se prvo u radnoj mapi, pa u
# korijenu klona kojem pripada build. Postavlja se samo kad runtime nije na uobicajenom mjestu.
OLX_TELEGRAM_ACCESS_FILE=
# Isto sto i gornja varijabla, ali za access.json ADMIN bot runtime-a (.claude-runtime-admin).
# Prazno je ispravno, isti redoslijed trazenja.
OLX_TELEGRAM_ACCESS_FILE_ADMIN=

# Javni domen platforme, za sastavljanje linka na oglas. Mijenja se ako rebrand
# olx.ba -> pik.ba promijeni i javne adrese oglasa.
OLX_PUBLIC_URL=https://olx.ba

# Runtime mapa sesije (podesava je scripts/lib/sesija.mjs po tipu sesije, ne popunjava se rucno).
# Prazno pada na .claude-runtime. OPASNA POSLJEDICA: ova vrijednost odredjuje i KOJE Telegram
# inbox mape (fotografije klijenta) smiju biti obrisane pri ciscenju slika
# (src/core/slike-ciscenje.ts) i koji settings.json (permissions.deny, plugini) sesija ucitava.
# Pogresna vrijednost moze ostaviti pogresan inbox nedirnutim ili, obrnuto, izloziti pogresnu mapu
# brisanju.
CLAUDE_CONFIG_DIR=
# Mapa stanja Telegram plugina za ovaj runtime (podesava je scripts/lib/sesija.mjs, ne popunjava
# se rucno). Prazno pada na plugin-ov ugradjeni default.
TELEGRAM_STATE_DIR=

# Rok (ms) za jedan potez mosta izmedju cuvara i sesije (scripts/telegram-most.mjs). Prazno
# pada na default 300000 (5 min).
OLX_MOST_POTEZ_TIMEOUT_MS=300000

# =====================================================================
# BACKUP STANJA (posao backup, 08:10)
# =====================================================================

# Salje se pamcenje, izuzeca, audit trag, snapshoti pregleda i profil klijenta. Tokeni se
# NAMJERNO ne salju: na novoj masini se unose rucno, a oba su obnovljiva.
# Bez ovoga klijentsko stanje postoji samo na disku ove masine. Snapshoti su nezamjenjivi
# retroaktivno, jer OLX ne daje istorijske preglede.

# Kratko ime klijenta. Postaje ime grane u repou stanja. NE izvodi se iz imena foldera:
# preimenovanje foldera bi tiho pokrenulo novu praznu granu i stari backup bi prestao da se puni.
OLX_KLIJENT=
# Privatan repo u koji ide stanje. Jedan repo, jedna grana po klijentu.
OLX_STANJE_REPO=
# Fine grained PAT samo za taj repo, Contents read and write. Ne ide u remote URL.
OLX_STANJE_TOKEN=
# YYYY-MM-DD, datum isteka tokena. Posao alarmira 14 dana ranije, jer istekao token tiho
# ubija backup i to se otkrije tek na dan kad zatreba.
OLX_STANJE_TOKEN_ISTICE=
# Radna kopija grane. Prazno pada na ~/olx-stanje/<grana>. MORA biti van klona: unutra bi je
# azurirac vidio kao lokalnu izmjenu i klon bi trajno prestao da se azurira.
OLX_STANJE_RADNA=

# Spisak klonova flote (koriste ga backup-nadzor.sh, ai-runda.sh, scripts/lib/klonovi.mjs).
# Redoslijed: OLX_KLIJENTI_ROOT (folder sken svih podmapa sa .olx-pik) ima prednost; inace
# OLX_KLIJENTI_POPIS je putanja do fajla sa jednom apsolutnom putanjom po redu; prazno pada na
# ~/.olx-klijenti.txt. Na obicnom klijentskom klonu obje ostaju prazne.
OLX_KLIJENTI_ROOT=
OLX_KLIJENTI_POPIS=

# =====================================================================
# SAMO ADMIN MASINA (upravljanje flotom, izdanja, PikGPT onboarding)
# =====================================================================
# Sve u ovoj sekciji vrijedi ISKLJUCIVO na masini koja upravlja flotom klijentskih klonova.
# Klijentski klon ove varijable NIKAD ne treba i ostavlja ih prazne.

# Prekidac izdanja (tag) koji flota prati. Cita se u scripts/pusti-u-flotu.mjs,
# scripts/azuriraj-ovaj-klon.mjs, scripts/provjeri-izdanje.mjs, scripts/azuriraj-sve.sh i
# deploy/windows/azuriraj.ps1. Prazno pada na "stabilno".
OLX_TAG=stabilno

# Prag (u danima) starosti zadnjeg backupa poslije kojeg backup-nadzor.sh javlja alarm. Prazno
# pada na default 3.
OLX_BACKUP_PRAG_DANA=3

# PikGPT onboarding (scripts/lib/podesavanja.mjs): bazna mapa za konfiguraciju i kljuceve, prazno
# pada na ~/.pikgpt.
PIKGPT_DIR=
# Putanja privatnog kljuca za onboarding. Prazno pada na onboarding-priv.b64 u PIKGPT_DIR.
PIKGPT_ONBOARDING_KEY=
# Bazni URL PikGPT worker-a. Nema default, mora biti postavljen (ili konfigurisan u fajlu) da
# onboarding radi.
PIKGPT_WORKER_BASE=
# Tajna za pull sa PikGPT worker-a. Nema default, mora biti postavljena (ili konfigurisana u
# fajlu) da onboarding radi. Tajna, nikad stvarna vrijednost u primjeru.
PIKGPT_PULL_SECRET=
