<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sablon. Instalira ga scripts/instaliraj-cron.sh.

  Snapshot je odvojen od dnevne poruke i ide nocu jer je spor: jedan zahtjev po oglasu, izmjereno
  83 sekunde za 168 oglasa. Poruka u 07:20 samo cita rezultat sa diska.

  Bez ovog posla nema mjerenja ucinka: `views` je kumulativan, pa se prirast racuna iskljucivo
  kao razlika dva snimka.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ba.codefactory.olx.KLIJENT.snapshot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd KORIJEN &amp;&amp; node dist/cli/index.js stats snapshot</string>
  </array>

  <key>WorkingDirectory</key>
  <string>KORIJEN</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>40</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>KORIJEN/.olx-pik/cron-snapshot.log</string>
  <key>StandardErrorPath</key>
  <string>KORIJEN/.olx-pik/cron-snapshot.log</string>
</dict>
</plist>
