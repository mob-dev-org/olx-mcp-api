<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sablon. Instalira se RUCNO i samo JEDNOM na admin masini (kao ADMIN.saznanja i ADMIN.ai-runda),
  jer skripta sama obilazi sve klonove iz ~/.olx-klijenti.txt.

  Instalacija (KORIJEN je putanja glavnog repoa):
    sed "s|KORIJEN|$PWD|g" deploy/launchd/ba.codefactory.olx.ADMIN.backup-nadzor.plist \
      > ~/Library/LaunchAgents/ba.codefactory.olx.ADMIN.backup-nadzor.plist
    launchctl bootstrap "gui/$(id -u)" ~/Library/LaunchAgents/ba.codefactory.olx.ADMIN.backup-nadzor.plist

  Ponedjeljak 09:00: poslije sedmicnih izvjestaja, pa sedmica pocinje sa provjerenim backupom.

  Zasto uopste postoji: backup koji se ugasio ne javlja nista. Neinstaliran posao, ugasena masina
  i istekao token izgledaju isto, a alarm iz samog posla moze i sam pasti. Zato se pita sa druge
  strane, sa daljinskog repoa. Poruka ide samo kad nesto kasni.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ba.codefactory.olx.ADMIN.backup-nadzor</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd KORIJEN &amp;&amp; scripts/backup-nadzor.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>KORIJEN</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>KORIJEN/.olx-pik/cron-backup-nadzor.log</string>
  <key>StandardErrorPath</key>
  <string>KORIJEN/.olx-pik/cron-backup-nadzor.log</string>
</dict>
</plist>
