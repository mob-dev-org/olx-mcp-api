<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sablon. Ne instalira se rucno: scripts/instaliraj-cron.sh zamijeni KLIJENT i KORIJEN.

  Zasto launchd a ne Claude cron: CronCreate u Claude Code zivi samo u sesiji i istice za 7 dana.
  Ovaj posao mora raditi i kad nijedna Claude sesija nije otvorena.

  RunAtLoad je false namjerno: restart racunara ne smije pokrenuti obnovu van reda.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ba.codefactory.olx.KLIJENT.dnevno</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd KORIJEN &amp;&amp; node dist/cli/index.js posao dnevni</string>
  </array>

  <key>WorkingDirectory</key>
  <string>KORIJEN</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>20</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>KORIJEN/.olx-pik/cron-dnevno.log</string>
  <key>StandardErrorPath</key>
  <string>KORIJEN/.olx-pik/cron-dnevno.log</string>
</dict>
</plist>
