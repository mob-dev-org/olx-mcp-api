<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sablon. Instalira ga scripts/instaliraj-cron.sh.
  Ponedjeljkom u 07:40, dvadeset minuta iza dnevne poruke da se dvije poruke ne slijepe.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ba.codefactory.olx.KLIJENT.sedmicno</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd KORIJEN &amp;&amp; bun dist/cli/index.js posao sedmicni</string>
  </array>

  <key>WorkingDirectory</key>
  <string>KORIJEN</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>40</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>KORIJEN/.olx-pik/cron-sedmicno.log</string>
  <key>StandardErrorPath</key>
  <string>KORIJEN/.olx-pik/cron-sedmicno.log</string>
</dict>
</plist>
