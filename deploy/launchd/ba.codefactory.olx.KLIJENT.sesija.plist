<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sablon. Instalira ga scripts/instaliraj-cron.sh.

  Klijentski Telegram most (scripts/telegram-most.mjs): headless claude -p sesija plus
  direktan Telegram sendMessage, bez cuvara i bez plugina. Most sam radi idle gasenje sesije
  (OLX_MOST_IDLE_MIN), nocni rez konteksta (OLX_MOST_RESTART_SAT), ciscenje inboxa i cron
  logova, i telemetriju resursa. Launchd ovdje samo drzi most ziv.

  Label OSTAJE ba.codefactory.olx.KLIJENT.sesija, iz ranijih cuvarskih dana, i ne mijenja se
  ni ovim prelazom: dva launchd posla na istom bot tokenu daju 409 Conflict (Telegram dopusta
  samo jednog getUpdates konzumera), pa bi novo ime pri nadogradnji zivog klona nakratko
  ostavilo dva konzumera. Isti Label znaci da launchctl bootout starog posla i bootstrap
  novog rade nad istim imenom, dakle nikad dva konzumera odjednom.

  bash -lc zbog PATH-a: claude i bun dolaze iz login profila, a launchd okruzenje ih nema. To
  samo po sebi NIJE dovoljno pouzdano: izmjereno 17.08.2026. na klijentu nabavi-ba da bash -lc
  povremeno ipak ne nadje "claude" (Executable not found in $PATH), iako isti "bash -lc" u
  interaktivnom terminalu radi ispravno. Simptom je opasan jer se sam ne vidi: DM proba (rucno
  pokrenuta sesija) prolazi, a most u produkciji tiho ne odgovara u grupi dok se korisnik ne
  pozali. Zato EnvironmentVariables/PATH ispod NIJE opciono vec dio sablona: eksplicitan PATH ne
  zavisi od login-shell tajminga i path_helper-a. Prilagodi ako je bun/claude instaliran drugdje
  (npr. drugi macOS korisnik ili verzija Homebrewa).

  KeepAlive na SuccessfulExit false ostaje ispravno i za most: idle gasenje i nocni restart
  most radi INTERNO, ubija samo claude dijete, a sam proces mosta ostaje ziv i sam digne
  sljedecu sesiju, pa launchd tu nema sta da restartuje. Restart ostaje samo za stvarni pad
  procesa mosta (izlaz razlicit od 0). Uredno gasenje (launchctl bootout, SIGTERM) most
  zavrsi izlazom 0 i launchd ga tada ne dize, sto je i dalje ono sto hocemo. RunAtLoad true
  jer bot mora ziv cim se racunar digne.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ba.codefactory.olx.KLIJENT.sesija</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd KORIJEN &amp;&amp; bun scripts/telegram-most.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>KORIJEN</string>

  <!-- Vidi napomenu iznad: bash -lc sam po sebi nije dovoljno pouzdan izvor PATH-a za "claude". -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:DOMACI_HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>KORIJEN/.olx-pik/cron-sesija.log</string>
  <key>StandardErrorPath</key>
  <string>KORIJEN/.olx-pik/cron-sesija.log</string>
</dict>
</plist>
