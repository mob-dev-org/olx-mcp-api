{
  "name": "olx-pik-toolkit",
  "version": "0.17.2",
  "description": "Interni CLI i MCP server za upravljanje OLX.ba / PIK.ba shopovima",
  "type": "module",
  "bin": {
    "olx": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "bun dist/cli/index.js",
    "mcp": "bun dist/mcp/server.js",
    "dev:cli": "tsc && bun dist/cli/index.js",
    "dev:mcp": "tsc && bun dist/mcp/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && bun scripts/testovi.mjs",
    "preversion": "bun run test",
    "version": "bun scripts/upisi-verziju.mjs && git add src/core/verzija.ts",
    "postversion": "bun run build",
    "chat": "bash scripts/claude-olx.sh",
    "klijent": "bun scripts/pokreni-klijenta.mjs",
    "deepseek:proba": "tsc && bun scripts/deepseek-proba.mjs",
    "kanal:proba": "bun scripts/proba-kanala.mjs",
    "most": "bun scripts/telegram-most.mjs",
    "ai:usage": "bun scripts/ai-usage.mjs",
    "tokeni": "bun scripts/tokeni-izvjestaj.mjs",
    "kontekst": "tsc && bun scripts/kontekst-izvjestaj.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@imgly/background-removal-node": "~1.4.5",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^12.1.0",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "sharp": "^0.34.5"
  },
  "trustedDependencies": []
}
