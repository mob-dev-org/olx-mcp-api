{
  "name": "olx-pik-toolkit",
  "version": "0.10.0",
  "description": "Interni CLI i MCP server za upravljanje OLX.ba / PIK.ba shopovima",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "olx": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/index.js",
    "mcp": "node dist/mcp/server.js",
    "dev:cli": "tsc && node dist/cli/index.js",
    "dev:mcp": "tsc && node dist/mcp/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node scripts/testovi.mjs",
    "preversion": "npm test",
    "version": "node scripts/upisi-verziju.mjs && git add src/core/verzija.ts",
    "postversion": "npm run build",
    "chat": "bash scripts/claude-olx.sh",
    "klijent": "node scripts/pokreni-klijenta.mjs",
    "deepseek:proba": "tsc && node scripts/deepseek-proba.mjs",
    "kanal:proba": "node scripts/proba-kanala.mjs",
    "most": "node scripts/telegram-most.mjs",
    "ai:usage": "node scripts/ai-usage.mjs",
    "tokeni": "node scripts/tokeni-izvjestaj.mjs",
    "kontekst": "tsc && node scripts/kontekst-izvjestaj.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "commander": "^12.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}
